{
  "name": "@eva_solutions/whatsapp-sdk",
  "version": "0.1.0",
  "description": "SDK TypeScript para consumir el servicio Whatsapp-api",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eva-solutions-org/whatsapp-sdk.git"
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./ws": {
      "import": {
        "types": "./dist/ws.d.ts",
        "default": "./dist/ws.js"
      },
      "require": {
        "types": "./dist/ws.d.cts",
        "default": "./dist/ws.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.cts",
        "default": "./dist/admin.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "publint": "publint --pack pnpm --strict",
    "attw": "attw --pack . --profile node16",
    "changeset": "changeset",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.59.0",
    "publint": "^0.3.25",
    "tsdown": "^0.21.10",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.2"
}
